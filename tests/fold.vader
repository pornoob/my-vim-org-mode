" Folding: fold levels from org#fold#expr, fold text and the fold commands.

Execute (helper):
  " Fold level of every line of the current buffer.
  function! Levels() abort
    return map(range(1, line('$')), 'foldlevel(v:val)')
  endfunction

Given org (headlines nest by level; body follows its headline):
  intro
  * A
  text
  ** A1
  text
  * B

Execute:
  AssertEqual [0, 1, 1, 2, 2, 1], Levels()

Given org (a line starting with *bold* is not a headline):
  * A
  *bold* start of a paragraph
  **also bold**
  text

Execute:
  AssertEqual [1, 1, 1, 1], Levels()

Given org (a drawer or block folds one level below its headline):
  * A
  :PROPERTIES:
  :ID:       x
  :END:
  body
  #+BEGIN_SRC sh
  echo hi
  #+END_SRC
  after

Execute:
  AssertEqual [1, 2, 2, 2, 1, 2, 2, 2, 1], Levels()

Given org (PROPERTIES right after LOGBOOK: two sibling folds, no drift):
  * A
  :LOGBOOK:
  - State "DONE"       from "TODO"       [2026-01-01 jue 10:00]
  :END:
  :PROPERTIES:
  :LAST_REPEAT: [2026-01-01 jue 10:00]
  :END:
  #+BEGIN_QUOTE
  q
  #+END_QUOTE
  body
  ** B
  x

Execute:
  AssertEqual [1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 1, 2, 2], Levels()
  " Closing the LOGBOOK fold hides only the drawer
  2
  normal! zc
  AssertEqual [2, 4], [foldclosed(2), foldclosedend(2)]
  AssertEqual -1, foldclosed(5)
  AssertEqual -1, foldclosed(11)

Given org (fold text shows state, priority and the line count):
  #+SEQ_TODO: TODO WAIT | DONE
  ** WAIT [#A] Call the bank :tag:
  body
  more

Execute:
  2
  normal! zc
  let v:foldstart = 2
  let v:foldend = 4
  AssertEqual '** WAIT [#A] Call the bank :tag:  (2L)', org#fold#text()

Given org (Tab toggles a headline fold; on a body line it indents):
  * A
  text

Execute:
  call org#fold#tab()
  AssertEqual 1, foldclosed(1)
  call org#fold#tab()
  AssertEqual -1, foldclosed(1)
  2
  call org#fold#tab()
  AssertEqual &shiftwidth, indent(2)

Given org (toggle_all: everything closed, then everything open):
  * A
  a
  * B
  b

Execute:
  call org#fold#toggle_all()
  AssertEqual [1, 3], [foldclosed(1), foldclosed(3)]
  call org#fold#toggle_all()
  AssertEqual [-1, -1], [foldclosed(1), foldclosed(3)]

Given org (S-Tab cycles OVERVIEW, CONTENTS, SHOW ALL):
  * A
  :PROPERTIES:
  :ID:       x
  :END:
  ** A1
  text

Execute:
  unlet! b:org_cycle
  call org#fold#shifttab()
  AssertEqual 1, foldclosed(1)
  call org#fold#shifttab()
  AssertEqual [-1, 2, -1], [foldclosed(1), foldclosed(2), foldclosed(5)]
  call org#fold#shifttab()
  AssertEqual [-1, -1], [foldclosed(2), foldclosed(6)]

Execute (helper):
  " Keyword popups over the closed folds of this window: [buffer line, column
  " after the window's text offset, text], so the case holds wherever Vader puts
  " the window.
  function! FoldPops() abort
    redraw!
    call org#fold#kw_popups()
    let win = getwininfo(win_getid())[0]
    let rows = {}
    for lnum in range(line('w0'), line('w$'))
      if foldclosed(lnum) == lnum
        let rows[screenpos(0, lnum, 1).row] = lnum
      endif
    endfor
    let out = []
    for [row, col, text] in org#fold#kw_popup_list()
      if has_key(rows, row) && col > win.wincol && col < win.wincol + win.width
        call add(out, [rows[row], col - win.wincol - win.textoff, text])
      endif
    endfor
    return out
  endfunction

Given org (closed folds keep the TODO keyword and priority colours, as popups):
  #+SEQ_TODO: TODO REPEAT | DONE
  * TODO [#A] Uno
  a
  ** REPEAT Dos
  b
  * Sin estado
  c
  * [#B] Solo prioridad
  d
  * DONE Tres
  e

Execute:
  " Given fills the buffer after the syntax ran: let it see #+SEQ_TODO
  set syntax=org
  normal! zM
  AssertEqual [[2, 2, 'TODO [#A]'], [8, 2, '[#B]'], [10, 2, 'DONE']], FoldPops()
  normal! zR
  AssertEqual [], FoldPops()
  normal! zM
  2
  normal! zo
  AssertEqual [[4, 3, 'REPEAT'], [8, 2, '[#B]'], [10, 2, 'DONE']], FoldPops()

Given org (a popup follows a keyword change):
  * TODO Uno
  a

Execute:
  normal! zM
  AssertEqual [[1, 2, 'TODO']], FoldPops()
  call setline(1, '* DONE Uno')
  AssertEqual [[1, 2, 'DONE']], FoldPops()
  call org#fold#clear_hl()
  AssertEqual [], org#fold#kw_popup_list()
